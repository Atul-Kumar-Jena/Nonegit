{
  "name": "@attendly/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Attendly API — the single source of truth that all three apps sync through.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/server.cjs",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:pg-native --sourcemap && esbuild scripts/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.cjs --external:pg-native",
    "migrate": "tsx --env-file-if-exists=.env scripts/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=.env scripts/cli.ts seed",
    "keys": "tsx scripts/cli.ts keys",
    "session:start": "tsx --env-file-if-exists=.env scripts/cli.ts session:start",
    "audit:verify": "tsx --env-file-if-exists=.env scripts/cli.ts audit:verify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@attendly/protocol": "*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
