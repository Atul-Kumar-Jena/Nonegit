# ─── Attendly API configuration ───────────────────────────────────────────
# Copy to .env and fill in. Generate the three secrets with:  npm run keys

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://attendly:attendly@localhost:5432/attendly
# Managed Postgres (Supabase, Neon, RDS…): encrypt the connection.
#   DATABASE_SSL_CA = the provider's CA certificate (PEM) → full verification (recommended)
#   DATABASE_SSL=no-verify → encrypted without certificate checking (fallback when no CA)
# DATABASE_SSL=no-verify
# DATABASE_SSL_CA=

# First run: create the institution and its first admin (safe to leave set; nothing is changed later).
# BOOTSTRAP_INSTITUTION_NAME=Green Valley College
# BOOTSTRAP_ADMIN_EMAIL=you@college.edu
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_TIMEZONE=Asia/Kolkata
# Optional demo accounts to try each role (no other data is created):
# BOOTSTRAP_DEMO_TEACHER_EMAIL=
# BOOTSTRAP_DEMO_STUDENT_EMAIL=

# Ed25519 seed that signs attendance receipts. Rotating it invalidates pinned apps.
SERVER_SIGNING_KEY=
# HMAC key for hashing OTPs / tokens at rest.
TOKEN_PEPPER=

# How one-time codes are delivered: console (printed to this log) | smtp
OTP_DELIVERY=console
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="Attendly <no-reply@your-domain>"

# SMS for phone sign-in: console | twilio | disabled
SMS_DELIVERY=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# Behind a reverse proxy / tunnel (Render, Railway, Cloudflare…)? set true so rate limits see real IPs.
TRUST_PROXY=false

# TESTING ONLY: enables the faculty test console at /dev?token=<value>. Leave empty in production.
DEV_TOOLS_TOKEN=

# TESTING ONLY: allow Android emulators / iOS simulators to bind (they have no hardware integrity).
ALLOW_EMULATORS=false

# Optional: put your own email/phone in the demo roster when running "npm run seed".
# SEED_STUDENT_EMAIL=you@gmail.com
# SEED_STUDENT_PHONE=+919876543210
