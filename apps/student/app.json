{
  "expo": {
    "name": "Attendly",
    "slug": "attendly-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "attendly",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050814",
    "ios": {
      "bundleIdentifier": "app.attendly.student",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Attendly uses the camera only to scan your class's attendance QR code.",
        "NSLocationWhenInUseUsageDescription": "Attendly checks your location only at the moment you scan, to confirm you are inside the classroom.",
        "NSFaceIDUsageDescription": "Attendly can require Face ID before each attendance scan."
      }
    },
    "android": {
      "package": "app.attendly.student",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050814"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050814",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Attendly uses the camera only to scan your class's attendance QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attendly checks your location only at the moment you scan, to confirm you are inside the classroom.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Attendly can require Face ID before each attendance scan."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Attendly can require Face ID before each attendance scan."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#22d3ee"
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
