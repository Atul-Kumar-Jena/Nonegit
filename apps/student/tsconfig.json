{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@kit/*": [
        "../../packages/app-kit/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/app-kit/src/**/*.ts",
    "../../packages/app-kit/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist-android",
    "test"
  ]
}
